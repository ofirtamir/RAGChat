# ── Frontend environment variables ────────────────────────────────────────
# Copy this file to .env.local for local dev and add the same vars to Vercel.

# Backend (Railway) origin
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8000

# ── NextAuth.js v5 (Auth.js) ──────────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials
# Get them from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be:
#   <your-frontend-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional — only required when AUTH_URL inference fails (proxies, etc.)
# AUTH_URL=https://your-domain.vercel.app
