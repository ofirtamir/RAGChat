# ── Backend environment variables ─────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to git.

# Required: Google Gemini API key
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override data directory (useful when using a volume mount in production)
# DATA_DIR=/app/data

# Optional: override uploads directory
# UPLOADS_DIR=/app/uploads

# Optional: Langfuse observability (leave empty to disable)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: override the LLM / embedding models
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=models/gemini-embedding-001

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production set this to your Vercel URL, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000
